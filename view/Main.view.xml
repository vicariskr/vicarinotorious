<mvc:View
    controllerName="weatherapp.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <App id="app">
        <pages>
            <Page title="Weather Forecast">
                <customHeader>
                    <Bar class="sapUiSmallMarginBottom">
                        <contentLeft>
                            <Title text="Weather App" level="H1"/>
                        </contentLeft>
                    </Bar>
                </customHeader>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <!-- Search Section -->
                        <VBox class="weatherSearchBox">
                            <HBox alignItems="Center" justifyContent="Center" class="sapUiSmallMarginBottom">
                                <Input
                                    id="cityInput"
                                    placeholder="Enter city name..."
                                    value="{view>/city}"
                                    width="300px"
                                    submit=".onSearchWeather"
                                    class="sapUiTinyMarginEnd"/>
                                <Button
                                    text="Search"
                                    type="Emphasized"
                                    press=".onSearchWeather"
                                    icon="sap-icon://search"/>
                            </HBox>
                            <HBox alignItems="Center" justifyContent="Center" class="sapUiTinyMarginBottom">
                                <Label text="API Key:" class="sapUiTinyMarginEnd"/>
                                <Input
                                    id="apiKeyInput"
                                    placeholder="Enter your OpenWeather API key"
                                    value="{view>/apiKey}"
                                    type="Password"
                                    width="300px"/>
                            </HBox>
                            <Text 
                                text="Get your free API key at: https://openweathermap.org/api"
                                class="sapUiTinyMarginBottom weatherHelpText"
                                textAlign="Center"/>
                        </VBox>

                        <!-- Error Message -->
                        <MessageStrip
                            visible="{= ${view>/error} !== null}"
                            text="{view>/error}"
                            type="Error"
                            showIcon="true"
                            class="sapUiMediumMarginBottom"/>

                        <!-- Current Weather Section -->
                        <Panel
                            headerText="Current Weather"
                            visible="{= ${weather>/main} !== undefined}"
                            class="weatherPanel sapUiMediumMarginBottom">
                            <VBox alignItems="Center" class="sapUiSmallMargin">
                                <Title 
                                    text="{weather>/name}, {weather>/sys/country}"
                                    level="H2"
                                    class="weatherCityTitle"/>
                                <HBox alignItems="Center" class="sapUiSmallMarginTop">
                                    <core:Icon
                                        src="sap-icon://weather-proofing"
                                        size="3rem"
                                        color="#1873B4"
                                        class="sapUiTinyMarginEnd"/>
                                    <Title
                                        text="{path: 'weather>/main/temp', formatter: '.formatter.formatTemperature'}"
                                        level="H1"
                                        class="weatherTemp"/>
                                </HBox>
                                <Text
                                    text="{weather>/weather/0/description}"
                                    class="weatherDescription"/>
                                
                                <l:Grid 
                                    defaultSpan="L6 M6 S12"
                                    class="sapUiSmallMarginTop weatherDetailsGrid">
                                    <VBox class="weatherDetailBox">
                                        <Label text="Feels Like"/>
                                        <Text text="{path: 'weather>/main/feels_like', formatter: '.formatter.formatTemperature'}"/>
                                    </VBox>
                                    <VBox class="weatherDetailBox">
                                        <Label text="Humidity"/>
                                        <Text text="{path: 'weather>/main/humidity', formatter: '.formatter.formatPercentage'}"/>
                                    </VBox>
                                    <VBox class="weatherDetailBox">
                                        <Label text="Wind Speed"/>
                                        <Text text="{path: 'weather>/wind/speed', formatter: '.formatter.formatWindSpeed'}"/>
                                    </VBox>
                                    <VBox class="weatherDetailBox">
                                        <Label text="Pressure"/>
                                        <Text text="{path: 'weather>/main/pressure', formatter: '.formatter.formatPressure'}"/>
                                    </VBox>
                                    <VBox class="weatherDetailBox">
                                        <Label text="Visibility"/>
                                        <Text text="{path: 'weather>/visibility', formatter: '.formatter.formatVisibility'}"/>
                                    </VBox>
                                    <VBox class="weatherDetailBox">
                                        <Label text="Clouds"/>
                                        <Text text="{path: 'weather>/clouds/all', formatter: '.formatter.formatPercentage'}"/>
                                    </VBox>
                                </l:Grid>
                            </VBox>
                        </Panel>

                        <!-- 5-Day Forecast Section -->
                        <Panel
                            headerText="5-Day Forecast"
                            visible="{= ${forecast>/list} !== undefined}"
                            class="weatherPanel">
                            <List
                                items="{
                                    path: 'forecast>/list',
                                    filters: [{
                                        path: 'dt_txt',
                                        test: '.filterNoonForecasts'
                                    }]
                                }"
                                noDataText="No forecast data available">
                                <CustomListItem class="forecastItem">
                                    <HBox 
                                        alignItems="Center"
                                        justifyContent="SpaceBetween"
                                        width="100%">
                                        <VBox width="30%">
                                            <Text 
                                                text="{path: 'forecast>dt', formatter: '.formatter.formatDate'}"
                                                class="forecastDate"/>
                                            <Text 
                                                text="{path: 'forecast>dt', formatter: '.formatter.formatDay'}"
                                                class="forecastDay"/>
                                        </VBox>
                                        <HBox alignItems="Center" width="40%">
                                            <core:Icon
                                                src="sap-icon://weather-proofing"
                                                size="2rem"
                                                color="#1873B4"
                                                class="sapUiTinyMarginEnd"/>
                                            <VBox>
                                                <Text 
                                                    text="{forecast>weather/0/description}"
                                                    class="forecastDescription"/>
                                            </VBox>
                                        </HBox>
                                        <VBox alignItems="End" width="30%">
                                            <Text 
                                                text="{path: 'forecast>main/temp', formatter: '.formatter.formatTemperature'}"
                                                class="forecastTemp"/>
                                            <Text 
                                                text="H: {path: 'forecast>main/temp_max', formatter: '.formatter.formatTemperature'} L: {path: 'forecast>main/temp_min', formatter: '.formatter.formatTemperature'}"
                                                class="forecastMinMax"/>
                                        </VBox>
                                    </HBox>
                                </CustomListItem>
                            </List>
                        </Panel>

                        <!-- Last Update Info -->
                        <Text
                            visible="{= ${view>/lastUpdate} !== null}"
                            text="Last updated: {path: 'view>/lastUpdate', formatter: '.formatter.formatDateTime'}"
                            class="sapUiSmallMarginTop weatherLastUpdate"
                            textAlign="Center"/>
                    </VBox>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
